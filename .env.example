# Investment Intelligence — Environment Variables
# Copy to .env (or symlink ../.env from repo root)

# ── SEC EDGAR fair-use identity ──────────────────────────────────────────
# Required by SEC for the User-Agent header (10 req/sec free, no key).
EDGAR_IDENTITY=Your Name your.email@example.com

# ── LLM keys (deepdive/narrative.py ONLY — Phase 6a) ─────────────────────
# Both optional. The data-fetch and screener paths are fully deterministic
# and call NO LLM. Set these only when you want to run narrative generation
# (`invest score-card TICKER --narrate`), which is the SOLE permitted call
# site. OpenAI is primary; Anthropic is the fallback when OpenAI 429/quota.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Provider preference: "openai" (default) | "anthropic" | "openai_only" | "anthropic_only"
NARRATIVE_PROVIDER=openai
# Override model IDs (defaults: gpt-4o-mini / claude-haiku-4-5)
# OPENAI_NARRATIVE_MODEL=gpt-4o-mini
# ANTHROPIC_NARRATIVE_MODEL=claude-haiku-4-5

# ── Database ──────────────────────────────────────────────────────────────
# SQLite (development)
DATABASE_URL=sqlite:///./investment_intelligence.db

# PostgreSQL / Neon (production)
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/investment_intelligence

# ── Application ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development   # development | production

# ── Screening ─────────────────────────────────────────────────────────────
# Exclusion policy for the screener (screener/policies/README.md). `none`
# excludes nothing; add-on packages can register others.
EXCLUSION_POLICY=none

# ── Optional market-data sources ──────────────────────────────────────────
# Polygon free tier: prices, technicals, short interest (ADR-019).
POLYGON_API_KEY=
# FMP: screener metadata only; the bulk screener needs a paid plan and
# INVEST_USE_FMP_SCREENER=1 (ADR-016).
FMP_API_KEY=
